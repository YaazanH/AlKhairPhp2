APP_NAME=Alkhair
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
IMAGE_UPLOAD_MAX_KB=20480

# Local receipt vision (install Ollama, pull the model, and install Poppler).
INVOICE_CAPTURE_ENGINE=vision
INVOICE_VISION_URL=http://127.0.0.1:11434
INVOICE_VISION_MODEL=qwen3.5:9b
INVOICE_VISION_TIMEOUT=120
# Optional basic printed-text mode: INVOICE_CAPTURE_ENGINE=tesseract
INVOICE_OCR_LANGUAGES=ara+eng
# INVOICE_OCR_TESSERACT=/usr/bin/tesseract
# INVOICE_OCR_PDFTOTEXT=/usr/bin/pdftotext
# INVOICE_OCR_PDFTOPPM=/usr/bin/pdftoppm
# INVOICE_OCR_PDFINFO=/usr/bin/pdfinfo
# INVOICE_OCR_TESSDATA=/usr/share/tesseract-ocr/5/tessdata

BCRYPT_ROUNDS=12
APP_TOKEN=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alkhairapp
DB_USERNAME=root
DB_PASSWORD=P@ssw0rd

# SaaS landlord database. This must be a separate database once SaaS mode is
# enabled. Do not put tenant-specific values in this file.
LANDLORD_DB_CONNECTION=mysql
LANDLORD_DB_HOST=127.0.0.1
LANDLORD_DB_PORT=3306
LANDLORD_DB_DATABASE=alkhair_landlord
LANDLORD_DB_USERNAME=root
LANDLORD_DB_PASSWORD=

# Tenant connection template. Sprint 3 sets only the database name after a
# request host resolves to an active tenant.
TENANT_DB_CONNECTION=mysql
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=
TENANT_BASE_DOMAIN=localhost
# Keep this empty so browser sessions stay isolated to each tenant subdomain.
SESSION_DOMAIN=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
